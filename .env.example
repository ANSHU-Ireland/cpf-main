# Copy this file to .env (gitignored) and fill in real values. Never commit secrets.

# PostgreSQL connection string used by @cpf/db and integration tests.
# When unset, DB integration tests are skipped (see EXTERNAL_ACTIONS_REQUIRED.md, EXT-01).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cpf_dev

# AWS/ECS may inject split values instead of a URL. Do not set both forms.
# PGHOST=database.internal
# PGPORT=5432
# PGDATABASE=cpf
# PGUSER=cpf_runtime
# PGPASSWORD=managed-secret
# PGSSL=true
# PGSSLROOTCERT=/path/to/aws-rds-global-bundle.pem

# local | preview | uat | pilot | production
APP_ENV=local

# true forces synthetic-only data; startup validation rejects unsafe combinations.
DEMO_DATA_ONLY=true

# Explicit application modes. Production rejects CPF_DEMO_MODE=true.
CPF_DEMO_MODE=true
CPF_DEMO_PERSISTENCE=true
CPF_API_BASE_URL=http://127.0.0.1:3000
CPF_ALLOWED_ORIGIN=http://127.0.0.1:4300

# UAT only. The seed rejects production and marks every generated credential reset-required.
# CPF_UAT_SHARED_PASSWORD=CPF-UAT-ChangeMe-2026!
# CPF_UAT_CREDENTIALS_DIR=artifacts/uat-credentials

# Required managed secrets in production. Never commit real values.
# CPF_IMPORT_DATA_KEY=
# CPF_INTEGRATION_DATA_KEY=
